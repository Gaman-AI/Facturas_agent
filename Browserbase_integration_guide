## Step 5: Error Handling and Monitoring

### 5.1 Add Session Monitoring
```python
class BrowserbaseManager:
    # ... existing code ...
    
    async def get_session_status(self, session_id: str) -> dict:
        """Get the current status of a session"""
        try:
            session = self.bb.sessions.retrieve(session_id)
            return {
                "status": session.status,
                "created_at": session.created_at,
                "updated_at": session.updated_at
            }
        except Exception as e:
            return {"error": str(e)}
    
    async def list_active_sessions(self) -> list:
        """List all active sessions"""
        try:
            sessions = self.bb.sessions.list(project_id=self.project_id)
            return [
                {
                    "id": s.id,
                    "status": s.status,
                    "created_at": s.created_at
                }
                for s in sessions.data
            ]
        except Exception as e:
            return []
```

