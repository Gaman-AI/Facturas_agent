### 4.2 JavaScript Integration
```javascript
function showLiveView(sessionInfo, readOnly = true) {
    const container = document.getElementById('live-view-container');
    const iframe = document.getElementById('live-view-frame');
    const sessionInfoEl = document.getElementById('session-info');
    
    // Set iframe source to live view URL
    iframe.src = sessionInfo.live_view_url;
    
    // Configure read-only vs read-write
    if (readOnly) {
        iframe.style.pointerEvents = 'none';
    } else {
        iframe.style.pointerEvents = 'auto';
    }
    
    // Show session information
    sessionInfoEl.innerHTML = `
        <strong>Session ID:</strong> ${sessionInfo.session_id}<br>
        <strong>Debug URL:</strong> <a href="${sessionInfo.debug_url}" target="_blank">Open Debug View</a>
    `;
    
    // Show the container
    container.style.display = 'block';
}

// Example usage when calling your API
async function runAutomationTask(taskData) {
    try {
        const response = await fetch('/api/browser-agent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(taskData)
        });
        
        const result = await response.json();
        
        if (result.success && result.session_info) {
            // Show live view
            showLiveView(result.session_info, true); // true for read-only
        }
        
        return result;
    } catch (error) {
        console.error('Error running automation task:', error);
    }
}
