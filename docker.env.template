# ===========================================
# CFDI Automation - Enhanced Docker Environment
# Production-ready configuration with security best practices
# ===========================================

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Server Configuration
PORT=8000
HOST=0.0.0.0
API_VERSION=v1

# ===========================================
# DATABASE CONFIGURATION (SUPABASE)
# ===========================================

# Supabase Database Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here_64_chars_minimum
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here_64_chars_minimum

# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================

# Next.js Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here_64_chars_minimum
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_BASE_URL=ws://localhost/api
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_DEBUG=false
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# JWT Configuration (MUST be 32+ characters)
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_32_characters_long_production
JWT_EXPIRES_IN=7d

# Session Security
SESSION_SECRET=your_super_secure_session_secret_key_at_least_32_characters_long_production

# Password Hashing
BCRYPT_ROUNDS=12

# ===========================================
# BROWSER AUTOMATION SERVICES
# ===========================================

# BrowserBase Configuration
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# Browser Automation Settings
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
MAX_BROWSER_INSTANCES=3
BROWSER_TIMEOUT=300000

# ===========================================
# AI SERVICES CONFIGURATION
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5-nano-2025-08-07

# Anthropic Configuration  
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google AI Configuration
GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# OCR & DOCUMENT PROCESSING
# ===========================================

# Azure Document Intelligence (for OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here

# ===========================================
# SECURITY SETTINGS
# ===========================================

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_STRICT_AUTH=true

# Content Security Policy
CSP_ENABLED=true

# ===========================================
# FILE UPLOAD & STORAGE
# ===========================================

# Upload Settings
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Temporary Files
TMP_DIR=/app/tmp
CLEANUP_TEMP_FILES=true

# ===========================================
# LOGGING & MONITORING
# ===========================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Monitoring & Health Checks
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
MEMORY_LIMIT_WARNING=80
CPU_LIMIT_WARNING=80

# ===========================================
# TASK PROCESSING CONFIGURATION
# ===========================================

# Task Management
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT_MINUTES=30
TASK_RETRY_ATTEMPTS=3
TASK_RETRY_DELAY=5000

# Queue Processing
QUEUE_CONCURRENCY=3
QUEUE_MAX_STALLED=1
QUEUE_DELAYED_DEBOUNCE=5000

# Worker Configuration
START_WORKER=true
WORKER_CONCURRENCY=2

# ===========================================
# PYTHON SERVICE CONFIGURATION
# ===========================================

# Python Browser Service
PYTHON_SERVICE_PORT=9000
PYTHON_EXECUTABLE=python
PYTHON_TASK_TIMEOUT=300000
PYTHON_SESSION_TIMEOUT=300000
PYTHON_MAX_RETRIES=3

# Display Configuration (for headless browser)
DISPLAY=:99
XVFB_RESOLUTION=1920x1080x24

# ===========================================
# SSL/TLS CONFIGURATION (PRODUCTION)
# ===========================================

# SSL Settings
ENABLE_SSL=false
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem
SSL_CA_PATH=/app/ssl/ca.pem

# HTTPS Redirect
FORCE_HTTPS=false
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ===========================================
# BACKUP & PERSISTENCE
# ===========================================

# Database Backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=/app/backups

# Data Persistence
PERSISTENT_STORAGE=true
DATA_RETENTION_DAYS=30

# ===========================================
# DEVELOPMENT & DEBUGGING (DISABLE IN PRODUCTION)
# ===========================================

# Debug Settings (SET TO false IN PRODUCTION)
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_CORS_DEBUG=false

# Development Tools
ENABLE_HOT_RELOAD=false
ENABLE_SOURCE_MAPS=false

# ===========================================
# DOCKER SPECIFIC SETTINGS
# ===========================================

# Container Settings
DOCKER_RESTART_POLICY=unless-stopped
DOCKER_MEMORY_LIMIT=4g
DOCKER_CPU_LIMIT=2

# Network Settings
DOCKER_NETWORK_NAME=cfdi_automation_network
DOCKER_SUBNET=172.20.0.0/16

# Volume Settings
DOCKER_VOLUME_PREFIX=cfdi_automation
