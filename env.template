# CFDI Automation - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# REQUIRED: Browserbase Configuration
# ==========================================
# Get these from https://browserbase.com/
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# ===========================================
# REQUIRED: AI Provider Configuration (at least one)
# ==========================================
# Get from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Alternative AI providers (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# REQUIRED: Supabase Configuration
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# REQUIRED: JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ===========================================
# OPTIONAL: Server Configuration
# ==========================================
PORT=8000
NODE_ENV=development
API_VERSION=v1

# ===========================================
# OPTIONAL: CORS Configuration
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# OPTIONAL: Task Configuration
# ==========================================
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT_MINUTES=30

# ===========================================
# OPTIONAL: Python Service Configuration
# ==========================================
PYTHON_SERVICE_PORT=8001
PYTHON_EXECUTABLE=python

# ===========================================
# OPTIONAL: Logging Configuration
# ==========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# OPTIONAL: Security Settings
# ==========================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# OPTIONAL: Upload Settings
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/uploads

# ===========================================
# OPTIONAL: Monitoring & Performance
# ==========================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# OPTIONAL: SSL Configuration (for production)
# ==========================================
SSL_CERT_PATH=
SSL_KEY_PATH=
ENABLE_SSL=false

# ===========================================
# OPTIONAL: Backup Configuration
# ==========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
