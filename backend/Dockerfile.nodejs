FROM node:20-alpine AS base

# Set environment variables
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH"

# Install pnpm globally
RUN corepack enable

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat python3 make g++ curl
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then \
    pnpm install --prod --frozen-lockfile; \
  elif [ -f package-lock.json ]; then \
    npm ci --only=production --frozen-lockfile; \
  else \
    npm install --only=production; \
  fi

# Install dev dependencies for building (if needed)
FROM base AS dev-deps
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN \
  if [ -f pnpm-lock.yaml ]; then \
    pnpm install --frozen-lockfile; \
  elif [ -f package-lock.json ]; then \
    npm ci --frozen-lockfile; \
  else \
    npm install; \
  fi

# Production image, copy all the files and run the app
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=8000

# Create system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs appuser

# Install curl for health checks
RUN apk add --no-cache curl

# Copy node_modules from deps stage
COPY --from=deps --chown=appuser:nodejs /app/node_modules ./node_modules

# Copy application source with proper ownership
COPY --chown=appuser:nodejs . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/{logs,data,tmp} && \
    chown -R appuser:nodejs /app/{logs,data,tmp} && \
    chmod 755 /app/{logs,data,tmp}

# Create startup script for better process management
COPY --chown=appuser:nodejs <<'EOF' /app/start.sh
#!/bin/sh
set -e

echo "🚀 Starting CFDI Automation Backend API..."
echo "📊 Node.js version: $(node --version)"
echo "📦 NPM version: $(npm --version)"
echo "🌍 Environment: $NODE_ENV"
echo "🔌 Port: $PORT"

# Start the application
exec node src/index.js
EOF

# Make startup script executable
RUN chmod +x /app/start.sh

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Enhanced health check with better error handling
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Use startup script as entrypoint
CMD ["/app/start.sh"] 