# Unified Dockerfile for Zeabur Deployment
# Combines Node.js backend with Python OCR functionality in a single container

# Stage 1: Base with both Node.js and Python
FROM node:20-alpine AS base

# Install Python and system dependencies
RUN apk add --no-cache \
    python3 \
    python3-dev \
    py3-pip \
    make \
    g++ \
    gcc \
    musl-dev \
    linux-headers \
    libffi-dev \
    openssl-dev \
    && rm -rf /var/cache/apk/*

# Create symlinks for python
RUN ln -sf python3 /usr/bin/python && \
    ln -sf pip3 /usr/bin/pip

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NODE_ENV=production \
    PORT=8080

WORKDIR /app

# Stage 2: Install Node.js dependencies
FROM base AS node-deps
COPY package*.json ./
RUN npm ci --only=production --cache /tmp/.npm \
    && npm cache clean --force \
    && rm -rf /tmp/.npm

# Stage 3: Install Python dependencies
FROM node-deps AS python-deps
COPY requirements.txt requirements_ocr.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r requirements_ocr.txt

# Stage 4: Copy application code
FROM python-deps AS app
COPY --chown=node:node . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/tmp /app/uploads \
    && chown -R node:node /app

# Set proper permissions
RUN chmod +x /app/src/services/run_ocr.py 2>/dev/null || true

# Switch to non-root user
USER node

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start the application
CMD ["node", "src/index.js"]
